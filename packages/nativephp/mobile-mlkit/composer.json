{
    "name": "nativephp/mobile-mlkit",
    "description": "TensorFlow Lite ML Kit integration for NativePHP Mobile - Shark teeth detection and custom object recognition",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "NativePHP",
            "email": "hello@nativephp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "NativePHP\\MobileMlkit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NativePHP\\MobileMlkit\\MobileMlkitServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-local-notifications.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-background-tasks.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-firebase.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-air.git"
        },
        {
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        }
    ],

    "require": {
        "php": "^8.5",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "laravel/framework": "^12.0",
        "livewire/flux-pro": "^2.10",
        "livewire/livewire": "^4.0",
        "nativephp/mobile": "dev-test/release-combined-66-68-71",
        "nativephp/mobile-background-tasks": "dev-main",
        "nativephp/mobile-biometrics": "^1.0",
        "nativephp/mobile-browser": "^1.0",
        "nativephp/mobile-camera": "^1.0",
        "nativephp/mobile-device": "^1.0",
        "nativephp/mobile-dialog": "^1.0",
        "nativephp/mobile-file": "^1.0",
        "nativephp/mobile-firebase": "dev-feature/push-deep-links-and-data-messages",
        "nativephp/mobile-geolocation": "*",
        "nativephp/mobile-local-notifications": "dev-main",
        "nativephp/mobile-microphone": "^1.0",
        "nativephp/mobile-network": "^1.0",
        "nativephp/mobile-scanner": "^1.0",
        "nativephp/mobile-secure-storage": "^1.0",
        "nativephp/mobile-share": "^1.0",
        "nativephp/mobile-system": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.7",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

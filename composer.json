{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": {
        "flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        "nativephp": {
            "type": "path",
            "url": "../mobile"
        },
        "nativephp-geolocation": {
            "type": "path",
            "url": "../Plugins/nativephp/geolocation"
        },
        "nativephp-microphone": {
            "type": "path",
            "url": "../Plugins/nativephp/microphone"
        },
        "nativephp-scanner": {
            "type": "path",
            "url": "../Plugins/nativephp/scanner"
        },
        "nativephp-biometrics": {
            "type": "path",
            "url": "../Plugins/nativephp/biometrics"
        },
        "nativephp-camera": {
            "type": "path",
            "url": "../Plugins/nativephp/camera"
        },
        "nativephp-push": {
            "type": "path",
            "url": "../Plugins/nativephp/firebase"
        },
        "nativephp-browser": {
            "type": "path",
            "url": "../Plugins/nativephp/browser"
        },
        "nativephp-wallet": {
            "type": "path",
            "url": "../Plugins/nativephp/wallet"
        }
    },
    "require": {
        "php": "^8.2",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "laravel/framework": "^12.0",
        "livewire/flux-pro": "^2.10",
        "livewire/livewire": "^3.7",
        "nativephp/mobile": "*",
        "nativephp/mobile-biometrics": "dev-main",
        "nativephp/mobile-browser": "dev-main",
        "nativephp/mobile-camera": "dev-main",
        "nativephp/mobile-firebase": "dev-main",
        "nativephp/mobile-geolocation": "*",
        "nativephp/mobile-microphone": "*",
        "nativephp/mobile-scanner": "dev-main",
        "nativephp/mobile-wallet": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.7",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
